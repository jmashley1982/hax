name: Deploy to GitHub Pages

# Builds the static site and publishes it via GitHub Pages. Triggers on
# push to main -- the repository's default branch -- plus a manual
# trigger for re-deploying without a new commit.
on:
  push:
    branches:
      - main
  workflow_dispatch:

# Least-privilege token scope for the Pages deployment API.
permissions:
  contents: read
  pages: write
  id-token: write

# Only one deploy in flight at a time; a newer push supersedes an
# in-progress one rather than queuing behind it.
concurrency:
  group: pages
  cancel-in-progress: true

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm

      - run: npm ci
      - run: npm run build

      # enablement:true turns Pages on via the API (and sets the source to
      # GitHub Actions) if it isn't already, so a fresh clone of this repo
      # deploys without anyone having to visit Settings -> Pages first.
      # Without it the first run fails with "Get Pages site failed... verify
      # that the repository has Pages enabled".
      - uses: actions/configure-pages@v5
        with:
          enablement: true

      # The whole app is one self-contained dist/index.html (vite-plugin-
      # singlefile) plus a favicon -- see vite.config.ts's header comment
      # for why nothing is split out. Uploading dist/ as-is is correct.
      - uses: actions/upload-pages-artifact@v3
        with:
          path: dist

  deploy:
    needs: build
    runs-on: ubuntu-latest
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - id: deployment
        uses: actions/deploy-pages@v4
